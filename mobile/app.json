{
  "expo": {
    "name": "BIOCLIM",
    "slug": "ubicacionnewapp",
    "version": "1.0.48",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ubicacion",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permite que BIOCLIM muestre tu posición en el mapa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BIO CLIM sigue enviando tu ubicación con la app cerrada, la pantalla bloqueada o en otra aplicación.",
        "NSLocationAlwaysUsageDescription": "BIO CLIM sigue enviando tu ubicación con la app cerrada, la pantalla bloqueada o en otra aplicación.",
        "UIBackgroundModes": ["location"],
        "NSCameraUsageDescription": "Permite tomar fotos de la entrada de proveedores.",
        "NSPhotoLibraryUsageDescription": "Permite elegir fotos de la entrada de proveedores."
      }
    },
    "android": {
      "versionCode": 50,
      "package": "com.ubicacionnewapp.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "WAKE_LOCK",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que BIOCLIM muestre tu posición en el mapa.",
          "locationAlwaysAndWhenInUsePermission": "BIO CLIM sigue enviando tu ubicación con la app cerrada, la pantalla bloqueada o en otra aplicación.",
          "locationAlwaysPermission": "BIO CLIM sigue enviando tu ubicación con la app cerrada, la pantalla bloqueada o en otra aplicación.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de la entrada de proveedores.",
          "cameraPermission": "Permite tomar fotos de la entrada de proveedores."
        }
      ],
      "./plugins/with-location-foreground-type.js",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d377387-222e-4cd8-95e1-4a09d3c26e07"
      }
    },
    "owner": "alexquicio"
  }
}
