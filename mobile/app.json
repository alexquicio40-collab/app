{
  "expo": {
    "name": "Ubicación",
    "slug": "ubicacionnewapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ubicacion",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permite que Ubicación muestre tu posición en el mapa.",
        "NSCameraUsageDescription": "Permite tomar fotos de la entrada de proveedores.",
        "NSPhotoLibraryUsageDescription": "Permite elegir fotos de la entrada de proveedores."
      }
    },
    "android": {
      "versionCode": 2,
      "package": "com.ubicacionnewapp.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#12231F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Ubicación muestre tu posición en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de la entrada de proveedores.",
          "cameraPermission": "Permite tomar fotos de la entrada de proveedores."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d377387-222e-4cd8-95e1-4a09d3c26e07"
      }
    },
    "owner": "alexquicio"
  }
}
